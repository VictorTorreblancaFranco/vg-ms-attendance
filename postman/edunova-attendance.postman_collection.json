{
  "info": {
    "_postman_id": "e7f77c3b-5d88-4c77-8cb4-4d6efb8a9a01",
    "name": "EduNova - Attendance API",
    "description": "Coleccion para probar Attendance por medio del Gateway. El token se obtiene automaticamente con /auth/login y se guarda en accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const isLoginRequest = pm.info.requestName === 'Login';",
          "if (isLoginRequest) {",
          "  return;",
          "}",
          "",
          "const baseUrl = pm.collectionVariables.get('baseUrl');",
          "const email = pm.collectionVariables.get('authEmail');",
          "const password = pm.collectionVariables.get('authPassword');",
          "const token = pm.collectionVariables.get('accessToken');",
          "const expiresAt = Number(pm.collectionVariables.get('accessTokenExpiresAt') || 0);",
          "",
          "if (token && expiresAt && Date.now() < expiresAt - 60000) {",
          "  return;",
          "}",
          "",
          "pm.sendRequest({",
          "  url: `${baseUrl}/auth/login`,",
          "  method: 'POST',",
          "  header: {",
          "    'Content-Type': 'application/json'",
          "  },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({ email, password })",
          "  }",
          "}, function (err, res) {",
          "  if (err) {",
          "    throw new Error(`No se pudo obtener token: ${err.message || err}`);",
          "  }",
          "",
          "  if (!res || res.code < 200 || res.code >= 300) {",
          "    throw new Error(`Login fallo con HTTP ${res ? res.code : 'sin respuesta'}: ${res ? res.text() : ''}`);",
          "  }",
          "",
          "  const json = res.json();",
          "  if (!json.accessToken) {",
          "    throw new Error('La respuesta de login no trajo accessToken');",
          "  }",
          "",
          "  pm.collectionVariables.set('accessToken', json.accessToken);",
          "  pm.collectionVariables.set('refreshToken', json.refreshToken || '');",
          "  pm.collectionVariables.set('tokenType', json.tokenType || 'Bearer');",
          "  pm.collectionVariables.set('accessTokenExpiresAt', String(Date.now() + (json.expiresInMs || 3600000)));",
          "  pm.collectionVariables.set('authUsername', json.username || '');",
          "  pm.collectionVariables.set('authRoleCode', json.roleCode || '');",
          "});"
        ]
      }
    }
  ],
