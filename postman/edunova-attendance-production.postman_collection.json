    {
      "name": "03 - Attendance Mutations",
      "item": [
        {
          "name": "Register Individual Present - Prueba negativa 45 min",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta controlada', () => pm.expect([200, 201, 400, 401, 403, 404, 409]).to.include(pm.response.code));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) { try { const json = pm.response.json(); if (json.id) { pm.collectionVariables.set('attendanceId', String(json.id)); if (pm.environment && pm.environment.name) pm.environment.set('attendanceId', String(json.id)); } if (Array.isArray(json) && json[0]?.id) { pm.collectionVariables.set('attendanceId', String(json[0].id)); if (pm.environment && pm.environment.name) pm.environment.set('attendanceId', String(json[0].id)); } } catch(e) {} }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{currentUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "{{currentUserRole}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudianteId\": \"{{studentId}}\",\n  \"claseId\": \"{{classId}}\",\n  \"profesorId\": \"{{teacherId}}\",\n  \"registradoPor\": \"{{teacherId}}\",\n  \"fecha\": \"{{attendanceDate}}\",\n  \"anioLectivo\": \"{{academicYear}}\",\n  \"estado\": \"A\"\n}"
            },
            "url": "{{baseUrl}}/api/attendance",
            "description": "En produccion este endpoint individual bloquea clases pasadas por la regla de 45 minutos, incluso con usuario DEVELOPER. Usarlo para demostrar validacion negativa. Para registrar clase completa usa Register Bulk All Present - Auto Body."
          }
        },
        {
          "name": "Register Bulk All Present - Auto Body",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const students = JSON.parse(pm.collectionVariables.get('studentsJson') || pm.environment.get('studentsJson') || '[]');",
                  "if (!students.length) throw new Error('No hay studentsJson. Ejecuta 01 - Auto Discover Production Data primero.');",
                  "const body = {",
                  "  profesorId: pm.collectionVariables.get('teacherId') || pm.environment.get('teacherId'),",
                  "  fecha: pm.collectionVariables.get('attendanceDate') || pm.environment.get('attendanceDate'),",
                  "  anioLectivo: Number(pm.collectionVariables.get('academicYear') || pm.environment.get('academicYear') || pm.collectionVariables.get('yearId') || 1),",
                  "  asistencias: students.map(s => ({ estudianteId: s.studentId, estado: 'A' }))",
                  "};",
                  "pm.request.body.update(JSON.stringify(body, null, 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta controlada', () => pm.expect([200, 201, 400, 401, 403, 404, 409]).to.include(pm.response.code));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) { try { const json = pm.response.json(); if (json.id) { pm.collectionVariables.set('attendanceId', String(json.id)); if (pm.environment && pm.environment.name) pm.environment.set('attendanceId', String(json.id)); } if (Array.isArray(json) && json[0]?.id) { pm.collectionVariables.set('attendanceId', String(json[0].id)); if (pm.environment && pm.environment.name) pm.environment.set('attendanceId', String(json[0].id)); } } catch(e) {} }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{currentUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "{{currentUserRole}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ }"
            },
            "url": "{{baseUrl}}/api/attendance/class/{{classId}}/bulk",
            "description": "Flujo principal de registro de clase. Construye automaticamente el lote con todos los estudiantes de studentsJson. Probado contra produccion: con body incompleto responde la validacion correcta de que faltan estudiantes, sin guardar datos."
          }
        },
