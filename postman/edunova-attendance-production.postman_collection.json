  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const isLoginRequest = pm.info.requestName === 'Login - Produccion';",
          "if (isLoginRequest) return;",
          "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl');",
          "const email = pm.collectionVariables.get('authEmail') || pm.environment.get('authEmail');",
          "const password = pm.collectionVariables.get('authPassword') || pm.environment.get('authPassword');",
          "const token = pm.collectionVariables.get('accessToken') || pm.environment.get('accessToken');",
          "const expiresAt = Number(pm.collectionVariables.get('accessTokenExpiresAt') || pm.environment.get('accessTokenExpiresAt') || 0);",
          "if (token && expiresAt && Date.now() < expiresAt - 60000) return;",
          "pm.sendRequest({",
          "  url: `${baseUrl}/auth/login`,",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ email, password }) }",
          "}, (err, res) => {",
          "  if (err) throw new Error(`No se pudo obtener token: ${err.message || err}`);",
          "  if (!res || res.code < 200 || res.code >= 300) throw new Error(`Login fallo HTTP ${res ? res.code : 'sin respuesta'}: ${res ? res.text() : ''}`);",
          "  const json = res.json();",
          "  if (!json.accessToken) throw new Error('Login no devolvio accessToken');",
          "  pm.collectionVariables.set('accessToken', json.accessToken);",
          "  pm.collectionVariables.set('refreshToken', json.refreshToken || '');",
          "  pm.collectionVariables.set('accessTokenExpiresAt', String(Date.now() + (json.expiresInMs || 3600000)));",
          "  pm.collectionVariables.set('authUsername', json.username || '');",
          "  pm.collectionVariables.set('authRoleCode', json.roleCode || '');",
          "  if (pm.environment && pm.environment.name) {",
          "    pm.environment.set('accessToken', json.accessToken);",
          "    pm.environment.set('refreshToken', json.refreshToken || '');",
          "    pm.environment.set('accessTokenExpiresAt', String(Date.now() + (json.expiresInMs || 3600000)));",
          "    pm.environment.set('authUsername', json.username || '');",
          "    pm.environment.set('authRoleCode', json.roleCode || '');",
          "  }",
          "});"
        ]
      }
    }
  ],
