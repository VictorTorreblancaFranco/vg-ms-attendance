    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Login - Produccion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json(); pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', json.accessToken); if (pm.environment && pm.environment.name) pm.environment.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken || ''); if (pm.environment && pm.environment.name) pm.environment.set('refreshToken', json.refreshToken || '');",
                  "pm.collectionVariables.set('accessTokenExpiresAt', String(Date.now() + (json.expiresInMs || 3600000))); if (pm.environment && pm.environment.name) pm.environment.set('accessTokenExpiresAt', String(Date.now() + (json.expiresInMs || 3600000)));",
                  "pm.collectionVariables.set('authRoleCode', json.roleCode || ''); if (pm.environment && pm.environment.name) pm.environment.set('authRoleCode', json.roleCode || '');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Auto Discover Production Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request base respondio', () => pm.expect([200, 400, 401, 403, 404, 500]).to.include(pm.response.code));",
                  "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl');",
                  "const token = pm.collectionVariables.get('accessToken') || pm.environment.get('accessToken');",
                  "const authHeader = { Authorization: `Bearer ${token}` };",
                  "function setVar(key, value) { if (value !== undefined && value !== null && value !== '') { pm.collectionVariables.set(key, String(value)); if (pm.environment && pm.environment.name) pm.environment.set(key, String(value)); } }",
                  "function send(path) { return new Promise((resolve) => pm.sendRequest({ url: `${baseUrl}${path}`, method: 'GET', header: authHeader }, (err, res) => resolve({ err, res }))); }",
                  "function jsonArray(res) { try { const value = res && res.json(); return Array.isArray(value) ? value : []; } catch (e) { return []; } }",
                  "function previousDateForDay(dayOfWeek) {",
                  "  const today = new Date();",
                  "  const jsDay = today.getDay() === 0 ? 7 : today.getDay();",
                  "  const diff = (jsDay - Number(dayOfWeek) + 7) % 7;",
                  "  const date = new Date(today.getFullYear(), today.getMonth(), today.getDate() - diff);",
                  "  const y = date.getFullYear(); const m = String(date.getMonth() + 1).padStart(2, '0'); const d = String(date.getDate()).padStart(2, '0');",
                  "  return `${y}-${m}-${d}`;",
                  "}",
                  "(async () => {",
                  "  if (!token) throw new Error('No hay accessToken. Ejecuta Login primero.');",
                  "  const gradesRes = await send('/api/academic/grades');",
                  "  const sectionsRes = await send('/api/academic/sections');",
                  "  const coursesRes = await send('/api/academic/courses');",
                  "  const grades = jsonArray(gradesRes.res).filter(x => x.active !== false);",
                  "  const sections = jsonArray(sectionsRes.res).filter(x => x.active !== false);",
                  "  const courses = jsonArray(coursesRes.res).filter(x => x.active !== false);",
                  "  pm.test('Hay grados en produccion', () => pm.expect(grades.length, 'grados').to.be.greaterThan(0));",
                  "  pm.test('Hay secciones en produccion', () => pm.expect(sections.length, 'secciones').to.be.greaterThan(0));",
                  "  let selectedSchedule = null; let selectedStudents = [];",
                  "  for (const section of sections) {",
                  "    const gradeId = Number(section.gradeId); const sectionId = Number(section.id);",
                  "    if (!gradeId || !sectionId) continue;",
                  "    const schedulesRes = await send(`/schedules/grade/${gradeId}/section/${sectionId}`);",
                  "    const schedules = jsonArray(schedulesRes.res).filter(x => x && x.active !== false && x.id && x.teacherId);",
                  "    for (const schedule of schedules) {",
                  "      const yearId = Number(schedule.academicYearId || section.academicYearId || 1);",
                  "      const studentsRes = await send(`/api/attendance/class/${schedule.gradeId}/${schedule.sectionId}/students?yearId=${yearId}&limit=300`);",
                  "      const students = jsonArray(studentsRes.res).filter(x => x && x.isActive !== false && x.studentId);",
                  "      if (students.length > 0) { selectedSchedule = schedule; selectedStudents = students; break; }",
                  "    }",
                  "    if (selectedSchedule) break;",
                  "  }",
                  "  pm.test('Se encontro una clase con estudiantes', () => pm.expect(!!selectedSchedule, 'clase con estudiantes').to.equal(true));",
                  "  if (!selectedSchedule) return;",
                  "  const attendanceDate = previousDateForDay(selectedSchedule.dayOfWeek || 1);",
                  "  const course = courses.find(c => Number(c.id) === Number(selectedSchedule.courseId));",
                  "  const grade = grades.find(g => Number(g.id) === Number(selectedSchedule.gradeId));",
                  "  const section = sections.find(s => Number(s.id) === Number(selectedSchedule.sectionId));",
                  "  setVar('classId', selectedSchedule.id); setVar('teacherId', selectedSchedule.teacherId); setVar('gradeId', selectedSchedule.gradeId); setVar('sectionId', selectedSchedule.sectionId); setVar('yearId', selectedSchedule.academicYearId || 1); setVar('academicYear', selectedSchedule.academicYearId || 1); setVar('courseId', selectedSchedule.courseId); setVar('attendanceDate', attendanceDate);",
                  "  setVar('courseName', course?.name || `Curso ${selectedSchedule.courseId}`); setVar('gradeName', grade?.name || `Grado ${selectedSchedule.gradeId}`); setVar('sectionName', section?.name || `Seccion ${selectedSchedule.sectionId}`);",
                  "  setVar('studentId', selectedStudents[0]?.studentId); setVar('studentId2', selectedStudents[1]?.studentId || selectedStudents[0]?.studentId); setVar('studentsCount', selectedStudents.length);",
                  "  pm.collectionVariables.set('studentsJson', JSON.stringify(selectedStudents)); if (pm.environment && pm.environment.name) pm.environment.set('studentsJson', JSON.stringify(selectedStudents));",
                  "  const attendanceRes = await send(`/api/attendance/class/${selectedSchedule.id}?fecha=${attendanceDate}&limit=300`);",
                  "  const attendances = jsonArray(attendanceRes.res);",
                  "  pm.collectionVariables.set('attendancesJson', JSON.stringify(attendances)); if (pm.environment && pm.environment.name) pm.environment.set('attendancesJson', JSON.stringify(attendances));",
                  "  if (attendances[0]?.id) setVar('attendanceId', attendances[0].id);",
                  "  console.log('Attendance data discovered', { selectedSchedule, attendanceDate, students: selectedStudents.length, attendances: attendances.length });",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{currentUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "{{currentUserRole}}"
              }
            ],
            "url": "{{baseUrl}}/api/attendance/date?fecha=2026-06-26&limit=1",
            "description": "Ejecuta este request despues del Login. Busca grados, secciones, horarios y estudiantes reales en produccion y llena las variables de la coleccion."
          }
        },
        {
          "name": "Find Empty Class For Bulk Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request base respondio', () => pm.expect([200, 400, 401, 403, 404, 500]).to.include(pm.response.code));",
                  "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl');",
                  "const token = pm.collectionVariables.get('accessToken') || pm.environment.get('accessToken');",
                  "const authHeader = { Authorization: `Bearer ${token}` };",
                  "function setVar(key, value) { if (value !== undefined && value !== null && value !== '') { pm.collectionVariables.set(key, String(value)); if (pm.environment && pm.environment.name) pm.environment.set(key, String(value)); } }",
                  "function send(path) { return new Promise((resolve) => pm.sendRequest({ url: `${baseUrl}${path}`, method: 'GET', header: authHeader }, (err, res) => resolve({ err, res }))); }",
                  "function jsonArray(res) { try { const value = res && res.json(); return Array.isArray(value) ? value : []; } catch (e) { return []; } }",
                  "function previousDateForDay(dayOfWeek) {",
                  "  const today = new Date();",
                  "  const jsDay = today.getDay() === 0 ? 7 : today.getDay();",
                  "  const diff = (jsDay - Number(dayOfWeek) + 7) % 7;",
                  "  const date = new Date(today.getFullYear(), today.getMonth(), today.getDate() - diff);",
                  "  const y = date.getFullYear(); const m = String(date.getMonth() + 1).padStart(2, '0'); const d = String(date.getDate()).padStart(2, '0');",
                  "  return `${y}-${m}-${d}`;",
                  "}",
                  "(async () => {",
                  "  if (!token) throw new Error('No hay accessToken. Ejecuta Login primero.');",
                  "  const gradesRes = await send('/api/academic/grades');",
                  "  const sectionsRes = await send('/api/academic/sections');",
                  "  const coursesRes = await send('/api/academic/courses');",
                  "  const grades = jsonArray(gradesRes.res).filter(x => x.active !== false);",
                  "  const sections = jsonArray(sectionsRes.res).filter(x => x.active !== false);",
                  "  const courses = jsonArray(coursesRes.res).filter(x => x.active !== false);",
                  "  let found = null; let foundStudents = []; let foundDate = '';",
                  "  for (const section of sections) {",
                  "    const gradeId = Number(section.gradeId); const sectionId = Number(section.id);",
                  "    if (!gradeId || !sectionId) continue;",
                  "    const schedulesRes = await send(`/schedules/grade/${gradeId}/section/${sectionId}`);",
                  "    const schedules = jsonArray(schedulesRes.res).filter(x => x && x.active !== false && x.id && x.teacherId);",
                  "    for (const schedule of schedules) {",
                  "      const yearId = Number(schedule.academicYearId || section.academicYearId || 1);",
                  "      const studentsRes = await send(`/api/attendance/class/${schedule.gradeId}/${schedule.sectionId}/students?yearId=${yearId}&limit=300`);",
                  "      const students = jsonArray(studentsRes.res).filter(x => x && x.isActive !== false && x.studentId);",
                  "      if (!students.length) continue;",
                  "      const date = previousDateForDay(schedule.dayOfWeek || 1);",
                  "      const attendanceRes = await send(`/api/attendance/class/${schedule.id}?fecha=${date}&limit=300`);",
                  "      const attendances = jsonArray(attendanceRes.res);",
                  "      if (attendances.length === 0) { found = schedule; foundStudents = students; foundDate = date; break; }",
                  "    }",
                  "    if (found) break;",
                  "  }",
                  "  pm.test('Se encontro clase sin asistencia para registrar', () => pm.expect(!!found, 'clase sin asistencia').to.equal(true));",
                  "  if (!found) throw new Error('No encontre una clase con estudiantes y sin asistencias. Para crear, necesitas una clase/fecha sin registros o usar una fecha/clase habilitada por negocio.');",
                  "  const course = courses.find(c => Number(c.id) === Number(found.courseId));",
                  "  const grade = grades.find(g => Number(g.id) === Number(found.gradeId));",
                  "  const section = sections.find(s => Number(s.id) === Number(found.sectionId));",
                  "  setVar('classId', found.id); setVar('teacherId', found.teacherId); setVar('gradeId', found.gradeId); setVar('sectionId', found.sectionId); setVar('yearId', found.academicYearId || 1); setVar('academicYear', found.academicYearId || 1); setVar('courseId', found.courseId); setVar('attendanceDate', foundDate);",
                  "  setVar('courseName', course?.name || `Curso ${found.courseId}`); setVar('gradeName', grade?.name || `Grado ${found.gradeId}`); setVar('sectionName', section?.name || `Seccion ${found.sectionId}`);",
                  "  setVar('studentId', foundStudents[0]?.studentId); setVar('studentId2', foundStudents[1]?.studentId || foundStudents[0]?.studentId); setVar('studentsCount', foundStudents.length);",
                  "  pm.collectionVariables.set('studentsJson', JSON.stringify(foundStudents)); if (pm.environment && pm.environment.name) pm.environment.set('studentsJson', JSON.stringify(foundStudents));",
                  "  pm.collectionVariables.set('attendancesJson', '[]'); if (pm.environment && pm.environment.name) pm.environment.set('attendancesJson', '[]');",
                  "  pm.collectionVariables.unset('attendanceId'); if (pm.environment && pm.environment.name) pm.environment.unset('attendanceId');",
                  "  console.log('Empty class ready for bulk register', { found, foundDate, students: foundStudents.length });",
                  "})();"
                ]
              }
            }
